<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Oracle.LinuxCompatibility.MySQL</RootNamespace>
    <AssemblyName>MySqlMonitor</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- 本地 GCModeller 源码(Core.vbproj)缺失，改为引用已预编译的运行时 DLL；
         MySql.Data 由 NuGet 还原(需联网)。在 Ubuntu 上构建时请改用 dotnet publish，
         或预先 dotnet build LibMySQL / PerformanceCounter 生成对应 DLL。 -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- MySQL 数据库驱动 (mysql-connector-net)，通过 NuGet 还原 -->
    <PackageReference Include="MySql.Data" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\LibMySQL\libmysql.vbproj" />
    <ProjectReference Include="..\PerformanceCounter\PerformanceCounter.vbproj" />
  </ItemGroup>

</Project>
